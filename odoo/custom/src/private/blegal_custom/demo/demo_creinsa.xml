<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="res_partner_creinsa" model="res.partner">
        <field name="name">Creinsa</field>
    </record>
    <record id="product_product_creinsa" model="product.product">
        <field name="name">Test Creinsa Product</field>
    </record>
    <record id="supplierinfo_product_creinsa" model="product.supplierinfo">
        <field name="partner_id" ref="res_partner_creinsa" />
        <field name="product_code">ASE-DOC-SUBASE</field>
    </record>
    <record id="account_move_creinsa" model="base.import.pdf.template">
        <field name="name">Facturas de compra Creinsa</field>
        <field name="model_id" ref="account.model_account_move" />
        <field
            name="child_field_id"
            ref="account.field_account_move__invoice_line_ids"
        />
        <!-- <field name="auto_detect_pattern">(?<=creinsa.com)[\S\s]*</field> -->
        <field name="header_items">Codigo,PVP,Unidades</field>
    </record>
    <!-- header Lines -->
    <record
        id="account_move_creinsa_line_partner_id"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_creinsa" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__partner_id" />
        <field name="value_type">fixed</field>
        <field name="fixed_value" ref="res_partner_creinsa" />
    </record>
    <record
        id="account_move_creinsa_line_move_type"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_creinsa" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__move_type" />
        <field name="value_type">fixed</field>
        <field
            name="fixed_value_selection"
            ref="account.selection__account_invoice_report__move_type__in_invoice"
        />
    </record>
    <record id="account_move_creinsa_line_ref" model="base.import.pdf.template.line">
        <field name="template_id" ref="account_move_creinsa" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__ref" />
        <field name="pattern">Fecha:\s(.*)\s</field>
        <field name="value_type">variable</field>
    </record>
    <record
        id="account_move_creinsa_line_invoice_date"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_creinsa" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__invoice_date" />
        <field name="pattern">Fecha:\s.*\s(.*)\s</field>
        <field name="value_type">variable</field>
        <field name="date_format">*d/*m/*Y</field>
    </record>
    <!-- Lines Lines -->
    <record
        id="account_move_creinsa_line_product_id"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_creinsa" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__product_id" />
        <field name="column">0</field>
        <field name="pattern">[0-9]{2} €(ASE-.*)</field>
        <field name="value_type">variable</field>
        <field name="search_field_id" ref="product.field_product_product__seller_ids" />
        <field
            name="search_subfield_id"
            ref="product.field_product_supplierinfo__product_code"
        />
        <!-- <field name="default_value">product.product,cls.env.ref('blegal_custom.product_product_creinsa').id</field>     -->
    </record>
    <record
        id="account_move_creinsa_line_price_unit"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_creinsa" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__price_unit" />
        <field name="column">1</field>
        <field
            name="pattern"
        >([0-9]{2,3},[0-9]{2}) [0-9]{1},00 [0-9]{1,3},[0-9]{2} €ASE-</field>
        <field name="value_type">variable</field>
        <field name="decimal_separator">comma</field>
    </record>
    <record
        id="account_move_creinsa_line_quantity"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_creinsa" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__quantity" />
        <field name="column">2</field>
        <field
            name="pattern"
        >[0-9]{2,3},[0-9]{2} ([0-9]{1},[0-9]{2}) [0-9]{1,3},[0-9]{2} €ASE-</field>
        <field name="value_type">variable</field>
        <field name="decimal_separator">comma</field>
    </record>
</odoo>
