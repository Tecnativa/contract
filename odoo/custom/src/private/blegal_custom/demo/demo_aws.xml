<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="res_partner_aws" model="res.partner">
        <field name="name">AWS</field>
    </record>
    <record id="product_product_aws" model="product.product">
        <field name="name">Test AWS Product</field>
    </record>
    <record id="account_move_aws" model="base.import.pdf.template">
        <field name="name">Facturas de compra AWS</field>
        <field name="model_id" ref="account.model_account_move" />
        <field
            name="child_field_id"
            ref="account.field_account_move__invoice_line_ids"
        />
        <!-- <field name="auto_detect_pattern">(?<=console.aws.amazon.com)[\S\s]*</field> -->
        <field name="header_items">Producto,Precio</field>
    </record>
    <!-- header Lines -->
    <record id="account_move_aws_line_partner_id" model="base.import.pdf.template.line">
        <field name="template_id" ref="account_move_aws" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__partner_id" />
        <field name="value_type">fixed</field>
        <field name="fixed_value" ref="res_partner_aws" />
    </record>
    <record id="account_move_aws_line_move_type" model="base.import.pdf.template.line">
        <field name="template_id" ref="account_move_aws" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__move_type" />
        <field name="value_type">fixed</field>
        <field
            name="fixed_value_selection"
            ref="account.selection__account_invoice_report__move_type__in_invoice"
        />
    </record>
    <record id="account_move_aws_line_ref" model="base.import.pdf.template.line">
        <field name="template_id" ref="account_move_aws" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__ref" />
        <field name="pattern">VAT Invoice Number: ([A-Z-0-9]{8}-[0-9]{5})</field>
        <field name="value_type">variable</field>
    </record>
    <record
        id="account_move_aws_line_invoice_date"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_aws" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__invoice_date" />
        <field
            name="pattern"
        >VAT Invoice Date: ([A-Z-a-z]{3,9} [0-9]{1,2}, [0-9]{4})</field>
        <field name="value_type">variable</field>
        <field name="date_format">*B *d, *Y</field>
    </record>
    <!-- Lines Lines -->
    <record id="account_move_aws_line_product_id" model="base.import.pdf.template.line">
        <field name="template_id" ref="account_move_aws" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__product_id" />
        <field name="column">0</field>
        <field
            name="pattern"
        >(Net Charges [(]After Credits\SDiscounts. excl. Tax[)])</field>
        <field name="value_type">variable</field>
        <field name="search_field_id" ref="product.field_product_product__name" />
        <!-- <field name="default_value">product.product,cls.env.ref('blegal_custom.product_product_aws').id</field> -->
    </record>
    <record id="account_move_aws_line_price_unit" model="base.import.pdf.template.line">
        <field name="template_id" ref="account_move_aws" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__price_unit" />
        <field name="column">1</field>
        <field
            name="pattern"
        >Net Charges [(]After Credits\SDiscounts. excl. Tax[)] EUR ([0-9]{1,4}.[0-9]{2})</field>
        <field name="value_type">variable</field>
        <field name="decimal_separator">dot</field>
    </record>
</odoo>
