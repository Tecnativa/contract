<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="res_partner_google" model="res.partner">
        <field name="name">Google</field>
    </record>
    <record id="product_product_google" model="product.product">
        <field name="name">Test Google Product</field>
    </record>
    <record id="account_move_google" model="base.import.pdf.template">
        <field name="name">Facturas de compra Google</field>
        <field name="model_id" ref="account.model_account_move" />
        <field
            name="child_field_id"
            ref="account.field_account_move__invoice_line_ids"
        />
        <!-- <field name="auto_detect_pattern">(?<=Google Cloud EMEA)[\S\s]*</field> -->
        <field name="header_items">Producto,Cantidad,Precio</field>
    </record>
    <!-- header Lines -->
    <record
        id="account_move_google_line_partner_id"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_google" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__partner_id" />
        <field name="value_type">fixed</field>
        <field name="fixed_value" ref="res_partner_google" />
    </record>
    <record
        id="account_move_google_line_move_type"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_google" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__move_type" />
        <field name="value_type">fixed</field>
        <field
            name="fixed_value_selection"
            ref="account.selection__account_invoice_report__move_type__in_invoice"
        />
    </record>
    <record id="account_move_google_line_ref" model="base.import.pdf.template.line">
        <field name="template_id" ref="account_move_google" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__ref" />
        <field name="pattern">Invoice number: ([0-9]*)\sPage</field>
        <field name="value_type">variable</field>
    </record>
    <record
        id="account_move_google_line_invoice_date"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_google" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__invoice_date" />
        <field name="pattern">[.]([0-9]{1,2} [a-zA-Z]{3,4} [0-9]{4})\s</field>
        <field name="value_type">variable</field>
        <field name="date_format">*d *b *Y</field>
    </record>
    <!-- Lines Lines -->
    <record
        id="account_move_google_line_product_id"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_google" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__product_id" />
        <field name="column">0</field>
        <field name="pattern">Invoice number: ([0-9]*)\sPage</field>
        <field name="search_field_id" ref="product.field_product_product__seller_ids" />
        <field
            name="search_subfield_id"
            ref="product.field_product_supplierinfo__product_code"
        />
        <!-- <field name="default_value">product.product,cls.env.ref('blegal_custom.product_product_google').id</field>     -->
    </record>
    <record
        id="account_move_google_line_quantity"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_google" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__quantity" />
        <field name="column">1</field>
        <field name="pattern">([0-9]{1,2}) [0-9]{2,3}[.][0-9]{2}\s</field>
        <field name="value_type">variable</field>
        <field name="decimal_separator">comma</field>
    </record>
    <record
        id="account_move_google_line_price_unit"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_google" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__price_unit" />
        <field name="column">2</field>
        <field name="pattern">[0-9]{1,2} ([0-9]{2,3}[.][0-9]{2})\s</field>
        <field name="value_type">variable</field>
        <field name="decimal_separator">comma</field>
    </record>
</odoo>
