<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="res_partner_ionos" model="res.partner">
        <field name="name">Ionos</field>
    </record>
    <record id="product_product_ionos" model="product.product">
        <field name="name">Test Ionos Product</field>
    </record>
    <record id="supplierinfo_product_ionos" model="product.supplierinfo">
        <field name="partner_id" ref="res_partner_ionos" />
        <field name="product_code">92952092</field>
    </record>
    <record id="account_move_ionos" model="base.import.pdf.template">
        <field name="name">Facturas de compra Ionos</field>
        <field name="model_id" ref="account.model_account_move" />
        <field
            name="child_field_id"
            ref="account.field_account_move__invoice_line_ids"
        />
        <!-- <field name="auto_detect_pattern">(?<=IONOS Cloud)[\S\s]*</field> -->
        <field name="header_items">Producto,Cuota</field>
    </record>
    <!-- header Lines -->
    <record
        id="account_move_ionos_line_partner_id"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_ionos" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__partner_id" />
        <field name="value_type">fixed</field>
        <field name="fixed_value" ref="res_partner_ionos" />
    </record>
    <record
        id="account_move_ionos_line_move_type"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_ionos" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__move_type" />
        <field name="value_type">fixed</field>
        <field
            name="fixed_value_selection"
            ref="account.selection__account_invoice_report__move_type__in_invoice"
        />
    </record>
    <record id="account_move_ionos_line_ref" model="base.import.pdf.template.line">
        <field name="template_id" ref="account_move_ionos" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__ref" />
        <field name="pattern">N.° de factura: ([0-9]*)\s</field>
        <field name="value_type">variable</field>
    </record>
    <record
        id="account_move_ionos_line_invoice_date"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_ionos" />
        <field name="related_model">header</field>
        <field name="field_id" ref="account.field_account_move__invoice_date" />
        <field name="pattern">Fecha de facturación: ([0-9|\/]{8})\s</field>
        <field name="value_type">variable</field>
        <field name="date_format">*d/*m/*y-short</field>
    </record>
    <!-- Lines Lines -->
    <record
        id="account_move_ionos_line_product_id"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_ionos" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__product_id" />
        <field name="column">0</field>
        <field name="pattern">Contrato: ([0-9]{8}) - IONOS</field>
        <field name="value_type">variable</field>
        <field name="search_field_id" ref="product.field_product_product__seller_ids" />
        <field
            name="search_subfield_id"
            ref="product.field_product_supplierinfo__product_code"
        />
        <!-- <field name="default_value">product.product,cls.env.ref('blegal_custom.product_product_ionos').id</field>     -->
    </record>
    <record
        id="account_move_ionos_line_price_unit"
        model="base.import.pdf.template.line"
    >
        <field name="template_id" ref="account_move_ionos" />
        <field name="related_model">lines</field>
        <field name="field_id" ref="account.field_account_move_line__price_unit" />
        <field name="column">1</field>
        <field name="pattern">Cuota [(]([0-9]{1,2},[0-9]{2}) EUR[)]</field>
        <field name="value_type">variable</field>
        <field name="decimal_separator">comma</field>
    </record>
</odoo>
